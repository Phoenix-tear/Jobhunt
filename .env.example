# Copy to .env (git-ignored) and fill in what you use. Never commit .env.

# Gemini API key (https://aistudio.google.com/apikey). Used for job scoring and tailoring advice; leave empty to run fully local/free tiers only.
GEMINI_API_KEY=

# Adzuna job-search API (free, https://developer.adzuna.com/). Leave empty to skip the Adzuna source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: only if you switch tailoring.provider to "anthropic" in config.local.yaml.
ANTHROPIC_API_KEY=
